{
  "name": "@genagent/video-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "独立的视频文案提取与内容分析 Agent Plugin，消费本地视频文件",
  "main": "dist/main.js",
  "files": [
    "dist",
    "skills",
    "plugin.json",
    "mcp.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/copy-app.mjs",
    "serve": "node dist/main.js --stdio",
    "start:stdio": "npm run build && npm run serve"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
